PORT=8787

# Cerveau 100 % local
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:1.7b
LLM_API_KEY=

# Images 100 % locales
# ComfyUI est le moteur principal. Mettre sdcpp pour forcer stable-diffusion.cpp.
IMAGE_PROVIDER=comfyui

# Moteur léger stable-diffusion.cpp de secours / diagnostic
# Ces chemins sont détectés automatiquement si le dossier est à côté du dépôt.
SDCPP_BIN=
# Si vide : DreamShaper local si présent, sinon Tiny-SD déjà installé avec ComfyUI.
SDCPP_MODEL=
# "auto" laisse stable-diffusion.cpp choisir Vulkan/CPU selon le PC.
SDCPP_BACKEND=auto
SDCPP_THREADS=2
SDCPP_STEPS=
SDCPP_CFG_SCALE=
SDCPP_CLIP_VISION=
SDCPP_IP_ADAPTER=
SDCPP_IP_ADAPTER_STRENGTH=0.85

# Contrôle qualité visuel local après génération
VISION_BASE_URL=http://127.0.0.1:11434
VISION_MODEL=moondream
VISION_TIMEOUT_MS=300000
VISUAL_QUALITY_REQUIRED=1
VISUAL_QUALITY_MAX_ATTEMPTS=3

# ComfyUI local (principal)
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_RUNTIME_MODE=cpu
COMFYUI_WORKFLOW_FILE=
COMFYUI_INPUT_DIR=C:\\AI\\ComfyUI_windows_portable\\ComfyUI\\input

# Mode cloud / hybride
# LOCAL_ONLY=1 sur le PC ; 0 sur Railway.
LOCAL_ONLY=1
APP_ACCESS_TOKEN=
MIGRATION_ENABLED=0

# Stockage configurable (utile avec un volume persistant)
DATA_DIR=
LIBRARY_DIR=
