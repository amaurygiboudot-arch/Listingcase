<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Réseau natif limité aux mises à jour signées et à une recherche documentaire sur réseau non facturé. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <!-- Nécessaire pour proposer une APK hors Play Store ; confirmation Android obligatoire. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <application
      android:allowBackup="false"
      android:label="TEST - JULIE Apprentissage"
      android:icon="@drawable/julie_icon"
      android:usesCleartextTraffic="false"
      android:theme="@style/AppTheme">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <receiver android:name=".JulieInstallReceiver" android:exported="false"/>
    <service android:name=".JulieResearchJobService"
        android:permission="android.permission.BIND_JOB_SERVICE"
        android:exported="false"/>
  </application>
</manifest>
